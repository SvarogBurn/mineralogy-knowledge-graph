[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Carbonate
                :Halide
                :NativeElement
                :Oxide
                :Phosphate
                :Silicate
                :Sulfate
                :Sulfide
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :HydrothermalDeposit
                :MagmaticDeposit
                :MetamorphicDeposit
                :SedimentaryDeposit
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :IgneousRock
